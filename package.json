{
  "name": "ascii-racer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc && npm test && vite build",
    "shots": "node scripts/shots.mjs",
    "drive": "node --disable-warning=ExperimentalWarning scripts/drive.ts",
    "db:start": "supabase db start",
    "db:test": "supabase db reset && supabase test db",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "supabase": "^3.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  }
}
