{
  "name": "ascii-racer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc && npm test && vite build",
    "shots": "node scripts/shots.mjs",
    "drive": "node --disable-warning=ExperimentalWarning scripts/drive.ts",
    "backend:start": "supabase start",
    "backend:test": "node scripts/backend.mjs",
    "backend:stop": "node scripts/backend.mjs stop"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "playwright-core": "^1.65.1",
    "supabase": "^3.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  }
}
